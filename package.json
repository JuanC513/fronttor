{
  "name": "tg-smart-tutor",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "set CHOKIDAR_USEPOLLING=1 && ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"**/*.{ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"**/*.{ts,html,scss,css,json}\"",
    "check:prompt-limits": "node scripts/check-prompt-limits-sync.mjs",
    "check": "npm run lint && npm run format:check && npm run check:prompt-limits",
    "prepare": "husky",
    "docs": "compodoc -p tsconfig.app.json",
    "docs:serve": "compodoc -p tsconfig.app.json -s",
    "docs:build": "compodoc -p tsconfig.json -d documentation"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/platform-browser": "^21.2.5",
    "@angular/router": "^21.2.5",
    "@primeuix/themes": "^2.0.3",
    "@supabase/supabase-js": "^2.98.0",
    "marked": "^17.0.5",
    "monaco-editor": "^0.55.1",
    "ngx-markdown": "^21.1.0",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.3",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.5",
    "@compodoc/compodoc": "^1.2.1",
    "@types/jasmine": "~5.1.0",
    "@types/marked": "^5.0.2",
    "angular-eslint": "21.0.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "supabase": "^2.114.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4"
  },
  "lint-staged": {
    "*.{ts,html,scss,css,json}": [
      "prettier --check",
      "eslint"
    ],
    "supabase/functions/_shared/prompts/question-prompt.ts": "node scripts/check-prompt-limits-sync.mjs",
    "src/app/domain/ai/services/ai-chat-service.ts": "node scripts/check-prompt-limits-sync.mjs",
    "supabase/functions/_shared/prompts/content-prompt.ts": "node scripts/check-prompt-limits-sync.mjs",
    "src/app/features/teaching/components/block-form-dialog/block-form-dialog/block-form-dialog.ts": "node scripts/check-prompt-limits-sync.mjs",
    "supabase/functions/_shared/prompts/exercise-prompt.ts": "node scripts/check-prompt-limits-sync.mjs",
    "src/app/features/teaching/components/ai-generate-panel/ai-generate-panel.ts": "node scripts/check-prompt-limits-sync.mjs",
    "supabase/functions/_shared/prompts/practice-prompt.ts": "node scripts/check-prompt-limits-sync.mjs",
    "src/app/features/playground/pages/practice-exercise/practice-exercise.ts": "node scripts/check-prompt-limits-sync.mjs",
    "supabase/functions/_shared/student-context.ts": "node scripts/check-prompt-limits-sync.mjs",
    "src/app/features/profile/pages/profile-page/profile-page.ts": "node scripts/check-prompt-limits-sync.mjs"
  }
}
